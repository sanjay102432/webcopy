# Port for the local server.
PORT=4173

# Set to 1 only when you intentionally want to analyze private/local addresses.
# Leaving this off keeps the analyzer from being used as an SSRF proxy.
ALLOW_PRIVATE=0

# Maximum scans per client IP in a rolling 10-minute window.
RATE_LIMIT_PER_10M=60

# Linked-page crawl defaults and ceilings.
# MAX_CRAWL_PAGES: how many linked pages one scan may read (hard cap 12).
# MAX_CRAWL_DEPTH: how many link-hops to follow (hard cap 3; 1 = entry links only).
# CRAWL_BUDGET_MS: wall-clock budget for the crawl pass per scan.
MAX_CRAWL_PAGES=6
MAX_CRAWL_DEPTH=1
CRAWL_BUDGET_MS=90000
